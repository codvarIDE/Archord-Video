# Normalise line endings so Windows/macOS/Linux contributors don't produce noisy diffs.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.bat   text eol=crlf

# Binary assets
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp4   binary
*.mov   binary
*.webm  binary
